{
  "name": "constructo-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @constructo/web dev",
    "dev:mobile": "pnpm --filter @constructo/mobile start",
    "build:web": "pnpm --filter @constructo/web build",
    "build:mobile": "pnpm --filter @constructo/mobile export",
    "build": "pnpm build:web && pnpm build:mobile",
    "lint": "pnpm --recursive --if-present run lint",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "test": "pnpm --recursive --if-present run test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  }
}
