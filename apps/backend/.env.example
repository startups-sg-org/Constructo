# Credenciais usadas pelo container PostgreSQL e pelo backend.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=constructo
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Opcional. Quando definida, substitui as variáveis acima.
# Dentro do Docker use o host "db"; fora dele, use "localhost".
# URL_POSTGRES=postgresql+asyncpg://postgres:change_me@db:5432/constructo
